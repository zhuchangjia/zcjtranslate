{
  "manifest_version": 3,
  "name": "指译 ZCJ Translate",
  "version": "0.22.2",
  "description": "纯离线网页及 PDF/Word 阅读翻译；内置英汉、日中词库与 OPUS-MT。",
  "permissions": ["storage", "contextMenus", "tts", "offscreen"],
  "background": { "service_worker": "src/background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "action": {
    "default_title": "指译设置",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+T" },
      "description": "翻译当前选中的文字"
    }
  }
}
